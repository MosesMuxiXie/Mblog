# 线上持久化存储（Upstash Redis REST）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 通过 Vercel Marketplace 绑定 Upstash 时自动提供的兼容变量
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 本地开发可选；未填写时数据保存在项目根目录的 findatime-meetings.json
FINDATIME_DATA_FILE=

# findatime 管理后台首次初始化口令；完成初始化后可从生产环境中移除
FINDATIME_ADMIN_SETUP_TOKEN=
# 本地开发可选；未填写时使用项目根目录下的 findatime-admin.json
FINDATIME_ADMIN_DATA_FILE=

# 博客后台在本地开发时的可选数据文件；默认使用项目根目录的 blog-admin.json
BLOG_ADMIN_DATA_FILE=
# 博客文章本地数据文件；默认使用项目根目录的 blogs.json
BLOG_DATA_FILE=
